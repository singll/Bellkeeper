# Bellkeeper .gitignore

# Binaries
bin/
bellkeeper
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code session files
.claude/

# Build artifacts
dist/

# Config (local overrides)
config/*.local.yaml
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/
!web/src/pages/logs/

# Test coverage
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# OS files
.DS_Store
Thumbs.db

# Frontend (if added later)
web/node_modules/
web/dist/
web/.cache/

# Python
__pycache__/
*.py[cod]
*$py.class

# Temporary files
tmp/
temp/
*.tmp

# Air hot reload
.air.toml
1.0-PROGRESS.md
