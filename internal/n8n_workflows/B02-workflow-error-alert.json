{
  "name": "B02-工作流错误告警",
  "nodes": [
    {
      "name": "Error Trigger",
      "id": "dfb4571f-04ad-5c83-a88c-f13c34d6b07a",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        300
      ]
    },
    {
      "name": "格式化错误告警",
      "id": "3b375a77-468a-578a-859d-28abf871ac90",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $json;\nconst e = j.execution || j.trigger || {};\nconst error = e.error || j.error || {};\nconst source = j.workflow?.name || j.workflow?.id || 'unknown';\nlet message = error.message || error.description || '(无错误详情)';\nmessage = String(message).replace(/(Bearer\\s+)[A-Za-z0-9._-]+/gi, '$1[redacted]').replace(/((?:api[_-]?key|access[_-]?token|password)\\s*[=:]\\s*)[^\\s,;]+/gi, '$1[redacted]');\nconst text = `🔴 工作流失败 · ${source}\n执行: ${e.id || '启动阶段'}\n节点: ${e.lastNodeExecuted || error.node?.name || 'unknown'}\n错误: ${message.slice(0, 1500)}`;\nreturn [{json:{message:text, txn:'n8n-error-'+$execution.id}}];"
      },
      "position": [
        200,
        300
      ]
    },
    {
      "name": "发送错误告警",
      "id": "592ce7dc-5b72-58e7-8940-5100aa3fde15",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.MATRIX_HOMESERVER_URL + '/_matrix/client/v3/rooms/' + encodeURIComponent($env.MATRIX_ROOM_ALERTS) + '/send/m.room.message/' + $json.txn }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MATRIX_BOT_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ msgtype:'m.notice', body:$json.message }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        600,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "格式化错误告警",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "格式化错误告警": {
      "main": [
        [
          {
            "node": "发送错误告警",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Shanghai",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true,
    "errorWorkflow": ""
  }
}
