{
  "name": "K02-RSS定时采集",
  "nodes": [
    {
      "name": "定时触发",
      "id": "1216598e-4b51-5d5e-8d81-b51cd93bb61a",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6,12,18 * * *"
            }
          ]
        }
      },
      "position": [
        0,
        300
      ]
    },
    {
      "name": "Webhook",
      "id": "b4ba0a78-8fad-5d8e-b066-e0ef08ecbbc4",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "rss-backfill",
        "responseMode": "onReceived",
        "options": {}
      },
      "position": [
        0,
        300
      ],
      "webhookId": "rss-backfill"
    },
    {
      "name": "由Bellkeeper采集到期订阅",
      "id": "3071bada-bb25-5ad2-b86c-7fd7db7966f7",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/rss/fetch-all",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 900000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "position": [
        400,
        300
      ]
    }
  ],
  "connections": {
    "定时触发": {
      "main": [
        [
          {
            "node": "由Bellkeeper采集到期订阅",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook": {
      "main": [
        [
          {
            "node": "由Bellkeeper采集到期订阅",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Shanghai",
    "errorWorkflow": "u0W5aC5Q6Y0cZGK6",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true
  }
}
