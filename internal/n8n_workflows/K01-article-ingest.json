{
  "name": "K01-文章智能入库",
  "nodes": [
    {
      "name": "Webhook",
      "id": "b4ba0a78-8fad-5d8e-b066-e0ef08ecbbc4",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "article-ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        300
      ],
      "webhookId": "article-ingest"
    },
    {
      "name": "校验文章",
      "id": "5a79c717-6695-5fed-92d5-89aded9b1cb8",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst url = String(body.url || '').trim();\nif (!/^https?:\\/\\/[^\\s]+$/i.test(url)) throw new Error('url 必须是 http(s) 地址');\nreturn [{json:{url,title:String(body.title || ''),channel_type:'auto',metadata:{source:'n8n-manual',tags:body.tags || [],category:body.category || ''}}}];"
      },
      "position": [
        200,
        300
      ]
    },
    {
      "name": "写入持久化抓取队列",
      "id": "31ed6f19-e442-5792-b680-b3dd83d6c098",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/crawl/queue/enqueue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "position": [
        400,
        300
      ]
    },
    {
      "name": "返回入队结果",
      "id": "f2cfe25d-cb6a-5917-8925-aa6fb44a9ca2",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success:true, status:$json.data.queued ? 'queued' : 'duplicate', ...$json.data } }}"
      },
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "校验文章",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "校验文章": {
      "main": [
        [
          {
            "node": "写入持久化抓取队列",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "写入持久化抓取队列": {
      "main": [
        [
          {
            "node": "返回入队结果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Shanghai",
    "errorWorkflow": "u0W5aC5Q6Y0cZGK6",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true
  }
}
