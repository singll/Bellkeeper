{
  "name": "K03-手动批量提交",
  "nodes": [
    {
      "name": "Webhook",
      "id": "b4ba0a78-8fad-5d8e-b066-e0ef08ecbbc4",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        300
      ],
      "webhookId": "manual-ingest"
    },
    {
      "name": "规范化批量地址",
      "id": "bb6e9b09-42a5-5c11-bdbc-4c12943b9d03",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b=$json.body || $json;\nconst raw=Array.isArray(b.urls)?b.urls:String(b.urls || b.url || '').split(/[\\n,]+/);\nconst urls=[...new Set(raw.map(x=>String(x).trim()).filter(Boolean))];\nif (!urls.length || urls.length>100) throw new Error('请提供 1–100 个 URL');\nfor (const url of urls) if (!/^https?:\\/\\/[^\\s]+$/i.test(url)) throw new Error('无效的 http(s) URL');\nreturn urls.map(url=>({json:{url,channel_type:'auto',metadata:{source:'n8n-manual-batch'}}}));"
      },
      "position": [
        200,
        300
      ]
    },
    {
      "name": "批量入队",
      "id": "bb637f1a-6785-57c6-940f-ea428c811a5a",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/crawl/queue/enqueue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "position": [
        400,
        300
      ]
    },
    {
      "name": "汇总入队结果",
      "id": "c3050cf3-06d5-5ea7-ada9-d6875f69049c",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const results=$input.all().map(x=>x.json.data); return [{json:{success:true,queued:results.filter(x=>x.queued).length,duplicate:results.filter(x=>!x.queued).length,results}}];"
      },
      "position": [
        600,
        300
      ]
    },
    {
      "name": "返回批量结果",
      "id": "b84359cd-c327-5963-a402-2035e8f199e8",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "规范化批量地址",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "规范化批量地址": {
      "main": [
        [
          {
            "node": "批量入队",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "批量入队": {
      "main": [
        [
          {
            "node": "汇总入队结果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "汇总入队结果": {
      "main": [
        [
          {
            "node": "返回批量结果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Shanghai",
    "errorWorkflow": "u0W5aC5Q6Y0cZGK6",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true
  }
}
