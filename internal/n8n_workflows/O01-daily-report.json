{
  "name": "O01-每日日报",
  "meta": {
    "instanceId": ""
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 21
            }
          ]
        }
      },
      "id": "o01-0001",
      "name": "每日21点触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/reports/daily/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"dry_run\": false,\n  \"skip_notify\": false\n}"
      },
      "id": "o01-0002",
      "name": "调用日报生成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-check",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "o01-0003",
      "name": "生成失败?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/matrix/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'alerts', message: '### ❌ 日报生成失败\\n\\n- 时间: ' + $now.setZone($env.BELLKEEPER_TIMEZONE || 'Asia/Shanghai').toFormat('yyyy-MM-dd HH:mm') + '\\n- 错误: ' + (typeof $json.error === 'string' ? $json.error : JSON.stringify($json.error)) + '\\n\\n请检查 Bellkeeper 日志和日报服务状态。', message_type: 'markdown' }) }}"
      },
      "id": "o01-0004",
      "name": "发送告警",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"module\": \"daily_report\",\n  \"action\": \"generate\",\n  \"status\": \"success\",\n  \"summary\": \"日报生成成功\"\n}"
      },
      "id": "o01-0005",
      "name": "记录成功日志",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        420
      ]
    }
  ],
  "connections": {
    "每日21点触发": {
      "main": [
        [
          {
            "node": "调用日报生成",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "调用日报生成": {
      "main": [
        [
          {
            "node": "生成失败?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "生成失败?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "生成失败?": {
      "main": [
        [
          {
            "node": "发送告警",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "记录成功日志",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "DDPUVypFAgyDOXgn"
  }
}
