{
  "name": "O01-服务健康监控",
  "meta": {
    "instanceId": ""
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtMinute": 5
            }
          ]
        }
      },
      "id": "health-0001",
      "name": "每5分钟触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BELLKEEPER_URL }}/api/health/detailed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        }
      },
      "id": "health-0002",
      "name": "获取服务状态",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst data = $input.first().json.data || $input.first().json;\nconst services = data.services || {};\nconst currentStatus = {};\n\nfor (const [name, svc] of Object.entries(services)) {\n  currentStatus[name] = svc.status;\n}\n\nconst prevStatus = staticData.prevStatus || {};\nconst changes = [];\n\nfor (const [name, status] of Object.entries(currentStatus)) {\n  const prev = prevStatus[name];\n  if (prev && prev !== status) {\n    const icon = status === 'up' ? '✅' : status === 'down' ? '❌' : '⚠️';\n    const prevIcon = prev === 'up' ? '✅' : prev === 'down' ? '❌' : '⚠️';\n    changes.push(`${prevIcon}→${icon} **${name}**: ${prev} → ${status}`);\n  }\n  if (!prev && status !== 'up') {\n    changes.push(`❌ **${name}**: ${status} (首次检测)`);\n  }\n}\n\nfor (const name of Object.keys(prevStatus)) {\n  if (!(name in currentStatus)) {\n    changes.push(`⏹️ **${name}**: 已从监控中移除`);\n  }\n}\n\nstaticData.prevStatus = currentStatus;\n\nreturn [{\n  json: {\n    hasChanges: changes.length > 0,\n    changes: changes,\n    overallStatus: data.status || 'unknown',\n    services: currentStatus,\n    markdown: changes.length > 0 ? `### 🔄 服务状态变更\\n\\n${changes.join('\\n')}\\n\\n**当前状态:**\\n\\n| 服务 | 状态 |\\n|------|------|\\n${Object.entries(currentStatus).map(([n, s]) => `| ${n} | ${s === 'up' ? '✅' : s === 'down' ? '❌' : '⚠️'} ${s} |`).join('\\n')}` : ''\n  }\n}];"
      },
      "id": "health-0003",
      "name": "汇总并对比状态",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-changes",
              "leftValue": "={{ $json.hasChanges }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "health-0004",
      "name": "有状态变化?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BELLKEEPER_URL }}/api/matrix/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.BELLKEEPER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=/*jSON*/\n{\n  \"channel\": \"alerts\",\n  \"message\": \"{{ $json.markdown }}\",\n  \"message_type\": \"markdown\"\n}"
      },
      "id": "health-0005",
      "name": "发送告警通知",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200]
    },
    {
      "id": "health-0006",
      "name": "无变化跳过",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1200, 420]
    }
  ],
  "connections": {
    "每5分钟触发": {
      "main": [
        [
          {
            "node": "获取服务状态",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "获取服务状态": {
      "main": [
        [
          {
            "node": "汇总并对比状态",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "汇总并对比状态": {
      "main": [
        [
          {
            "node": "有状态变化?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "有状态变化?": {
      "main": [
        [
          {
            "node": "发送告警通知",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "无变化跳过",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
